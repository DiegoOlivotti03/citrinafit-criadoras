# Copie para .env.local e preencha. Nunca commite o .env.local.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servidor (so no servidor, NUNCA no navegador).
# Usada para criar contas a partir de um convite.
SUPABASE_SERVICE_ROLE_KEY=

# Endereco publico do app (para montar os links de convite)
NEXT_PUBLIC_SITE_URL=https://criadoras.citrinafit.com.br

# Loja Citrina: sincronizacao de cupons (so no servidor, NUNCA no navegador).
# URL base da loja, sem barra no fim. O app chama POST {LOJA_URL}/api/public/cupons-sync
LOJA_URL=
CUPONS_SYNC_SECRET=
